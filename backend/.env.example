# 로컬(비-Docker)에서 uvicorn을 직접 실행할 때 사용. 실제 값을 .env로 복사해 사용하세요.
# Docker Compose로 db/redis를 띄우면 호스트 포트가 각각 5433/6380입니다(기본 포트는 다른 프로젝트와 충돌할 수 있어 회피).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/contract_ai
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=dev-only-insecure-secret-change-me
SEED_DEMO_USERS=true

# ---- AI·Document (ai/) ----
# LLM: OpenAI 호환 엔드포인트 하나로 전환 (vLLM / Ollama / 상용 API). 비우면 규칙 기반 오프라인 모드
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
# OCR: auto(OCR_BASE_URL -> paddle -> tesseract) | paddle_vl | paddle | tesseract
OCR_ENGINE=auto
# OCR 서빙 컨테이너(docker compose --profile gpu). 비우면 worker 안에서 로컬 엔진 실행
OCR_BASE_URL=
OCR_DPI=300
